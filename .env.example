# Copy this file to .env and change the values before going live.

# --- PostgreSQL ---
POSTGRES_DB=novix
POSTGRES_USER=novix
POSTGRES_PASSWORD=novix_password
DB_PORT=5433

# --- Backend ---
BACKEND_PORT=4000
BACKEND_PUBLIC_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# First admin account (created automatically on first start)
ADMIN_NAME=Academy Admin
ADMIN_EMAIL=admin@novix.pk
ADMIN_PASSWORD=Admin@12345

# Adds sample chapters content, MCQ tests and demo students. Set to false for production.
SEED_DEMO_DATA=true

# --- Frontend ---
FRONTEND_PORT=3000
